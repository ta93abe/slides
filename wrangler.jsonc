{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slides",
  "compatibility_date": "2026-09-06",
  "main": "src/worker.ts",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // ADR-0007: unused at runtime until TA-806 / TA-810. Empty bucket and queue are enough.
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "slides"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "images": {
    "binding": "IMAGES"
  },
  "queues": {
    "producers": [
      {
        "binding": "PDF_QUEUE",
        "queue": "slides-pdf"
      }
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "slides"
    }
  ],
  "workflows": [
    {
      "binding": "PDF_WORKFLOW",
      "name": "slides-pdf",
      "class_name": "PdfWorkflow"
    }
  ]
}
